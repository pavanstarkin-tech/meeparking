{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "partners": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "parkingSpaces": {
      ".indexOn": ["ownerId", "status", "lat", "lng", "city"],
      "$spaceId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "bookings": {
      ".indexOn": ["userId", "spaceId", "partnerId", "status"],
      "$bookingId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "walletTransactions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
