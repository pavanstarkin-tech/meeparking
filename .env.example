# MEE PARKING APPLICATION CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials

# Mapbox Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=mee-parking.firebaseapp.com
FIREBASE_DATABASE_URL=https://mee-parking-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=mee-parking
FIREBASE_STORAGE_BUCKET=mee-parking.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Razorpay Configuration (Payments & Wallet Top-up)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Configuration (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=ml_default
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Agora Configuration (Face-to-Face Video & Audio Calls)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Email Notification Service (SMTP / Nodemailer / Cloud Functions)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_smtp_password
SENDER_EMAIL=notifications@meeparking.com
